# Copy this file to .env and fill in the values. .env is ignored by git.
# Real environment variables override values from .env.

# Your personal tracker API key. You can set it here, or on the settings page
# (a key saved there wins over this one).
Tracker__ApiKey=REPLACEME

# Default tracker endpoints (required). At startup the app adds them to the database
# if it doesn't have them yet; after that the database values (edited on the settings
# page) are used, and these are what "Reset to default" puts back.
Tracker__PingUrl=https://bipro2interface.sseku.com/api/candidate-tracker/ping
Tracker__ConversionsUrl=https://bipro2interface.sseku.com/api/candidate-tracker/conversions

# Default auth header, shared by ping and purchase. Added to the database at the first
# start like the URLs. {api_key} is replaced with the key when a request is sent.
# Never put the key itself here.
Tracker__AuthHeaderName=Authorization
Tracker__AuthHeaderTemplate='Bearer {api_key}'

# Database (optional). Defaults to SQL Server LocalDB on Windows
# (set in backend/MiniCrm.Api/appsettings.json). Set this only to override it.
# For SQL Server in Docker (Mac/Linux), uncomment and adjust:
# ConnectionStrings__Default=Server=localhost,1433;Database=MiniCrm;User Id=sa;Password=Your_strong_pass1;TrustServerCertificate=True
